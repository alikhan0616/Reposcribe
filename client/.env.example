# Base URL of the RepoScribe server API.
# In dev the server runs on a different origin/port than the client.
NEXT_PUBLIC_API_URL=http://localhost:5000

# ─── Auth (Clerk — optional) ───
# Leave blank to run without auth. Set both (and the matching CLERK_SECRET_KEY
# on the server) to require sign-in. Keys: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
