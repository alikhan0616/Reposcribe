# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed client origins (CORS).
CLIENT_ORIGIN=http://localhost:3000

# ─── AWS S3 (raw repo file storage) ───────────────────────
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=reposcribe-repos
# For local dev against MinIO / LocalStack (leave blank for real AWS):
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ─── Qdrant (vector store) ────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=reposcribe_chunks

# ─── Redis (BullMQ ingestion queue) ───────────────────────
REDIS_URL=redis://localhost:6379

# ─── Embeddings (Hugging Face Inference — hf-inference router) ──
HF_API_KEY=
# Must be a model served by the hf-inference provider. bge-base = dim 768.
# Alternative: EMBEDDING_MODEL=BAAI/bge-small-en-v1.5 with EMBEDDING_DIM=384
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32
# URL is built as: ${HF_EMBEDDING_BASE}${EMBEDDING_MODEL}/pipeline/feature-extraction
HF_EMBEDDING_BASE=https://router.huggingface.co/hf-inference/models/

# ─── Agent LLM (OpenRouter — OpenAI-compatible) ───────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_PROVIDER=openrouter
# Must support tool/function calling & be currently free. Qwen free slugs are
# often rate-limited (429); gpt-oss-120b has been reliable. Alternatives:
#   qwen/qwen3-coder:free , meta-llama/llama-3.3-70b-instruct:free
LLM_MODEL=openai/gpt-oss-120b:free
LLM_TEMPERATURE=0.1
RETRIEVAL_TOP_K=8

# ─── GitHub (clone + github_api tool) ─────────────────────
GITHUB_TOKEN=

# ─── Docker sandbox (run_linter / run_tests) ──────────────
SANDBOX_IMAGE=reposcribe-sandbox:latest
SANDBOX_MEMORY=256m
SANDBOX_CPUS=1
SANDBOX_TIMEOUT_MS=15000

# ─── Auth (Clerk — optional) ──────────────────────────────
# Leave blank to run without auth (single anonymous user). Set both to enforce
# per-user auth + repo ownership. Get keys at https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ─── Rate limiting (express-rate-limit) ───────────────────
# Defaults are sensible; tune without redeploying. Limits are keyed per signed-in
# user (Clerk on) or per client IP (auth off). Auto-disabled under tests.
# RATE_LIMIT_ENABLED=true            # force on/off; unset = on except in tests
RATE_LIMIT_WINDOW_MS=60000           # sliding window (1 min)
RATE_LIMIT_INGEST_MAX=10             # POST /api/repos  (heavy: clone + embed)
RATE_LIMIT_CHAT_MAX=20               # POST /api/chat   (each msg = several LLM calls)
RATE_LIMIT_GLOBAL_MAX=100            # broad safety net across /api (health exempt)
# Reverse-proxy hops in front of the app (Render/Railway/Vercel = 1). MUST be a
# number, never "true" — express-rate-limit rejects true as IP-spoofable.
TRUST_PROXY=1
